+"""진료 예약 API (환자 신청 / 의사 조회·확정)."""
+
+from django.utils import timezone
+from rest_framework import status
+from rest_framework.decorators import api_view, permission_classes
+from rest_framework.permissions import IsAuthenticated
+from rest_framework.response import Response
+from drf_spectacular.utils import extend_schema
+
+from api.models import Appointment, Doctor, Patient
+from api.serializers import (
+    AppointmentCreateSerializer,
+    AppointmentSerializer,
+    AppointmentUpdateSerializer,
+)
+
+
+def _as_patient(user):
+    return Patient.objects.filter(patient_id=user.username).first()
+
+
+def _as_doctor(user):
+    return Doctor.objects.filter(doctor_id=user.username).first()
+
+
+def _active_conflict(doctor_id: str, scheduled_at, exclude_id=None):
+    """같은 의사·같은 시각에 requested/confirmed 예약이 있는지."""
+    qs = Appointment.objects.filter(
+        doctor_id=doctor_id,
+        scheduled_at=scheduled_at,
+        status__in=[Appointment.STATUS_REQUESTED, Appointment.STATUS_CONFIRMED],
+    )
+    if exclude_id is not None:
+        qs = qs.exclude(id=exclude_id)
+    return qs.exists()
+
+
+@extend_schema(tags=["appointments"])
+@api_view(["GET", "POST"])
+@permission_classes([IsAuthenticated])
+def appointment_list_create(request):
+    """
+    GET  - 환자: 내 예약 / 의사: 내 예약 목록
+    POST - 환자: 예약 신청 (status=requested)
+    """
+    if request.method == "GET":
+        return _list_appointments(request)
+    return _create_appointment(request)
+
+
+def _list_appointments(request):
+    patient = _as_patient(request.user)
+    doctor = _as_doctor(request.user)
+
+    qs = Appointment.objects.all()
+    if patient is not None:
+        qs = qs.filter(patient_id=patient.patient_id)
+    elif doctor is not None:
+        qs = qs.filter(doctor_id=doctor.doctor_id)
+    else:
+        return Response(
+            {"detail": "환자 또는 의사 계정으로만 조회할 수 있습니다."},
+            status=status.HTTP_403_FORBIDDEN,
+        )
+
+    status_q = (request.query_params.get("status") or "").strip()
+    if status_q:
+        qs = qs.filter(status=status_q)
+
+    date_q = (request.query_params.get("date") or "").strip()  # YYYY-MM-DD
+    if date_q:
+        qs = qs.filter(scheduled_at__date=date_q)
+
+    # 취소 제외 기본값 (include_cancelled=1 이면 포함)
+    include_cancelled = request.query_params.get("include_cancelled") == "1"
+    if not include_cancelled:
+        qs = qs.exclude(status=Appointment.STATUS_CANCELLED)
+
+    qs = qs.order_by("scheduled_at", "id")
+    return Response(AppointmentSerializer(qs, many=True).data)
+
+
+def _create_appointment(request):
+    patient = _as_patient(request.user)
+    if patient is None:
+        return Response(
+            {"detail": "환자 계정으로만 예약을 신청할 수 있습니다."},
+            status=status.HTTP_403_FORBIDDEN,
+        )
+
+    ser = AppointmentCreateSerializer(data=request.data)
+    ser.is_valid(raise_exception=True)
+    data = ser.validated_data
+
+    doctor_id = data["doctor_id"].strip()
+    doctor = Doctor.objects.filter(doctor_id=doctor_id).first()
+    if doctor is None:
+        return Response(
+            {"detail": "선택한 의사를 찾을 수 없습니다."},
+            status=status.HTTP_400_BAD_REQUEST,
+        )
+
+    department = (data.get("department") or doctor.department or "").strip()
+    scheduled_at = data["scheduled_at"]
+    if timezone.is_naive(scheduled_at):
+        scheduled_at = timezone.make_aware(
+            scheduled_at, timezone.get_current_timezone()
+        )
+
+    if scheduled_at <= timezone.now():
+        return Response(
+            {"detail": "과거 일시로는 예약할 수 없습니다."},
+            status=status.HTTP_400_BAD_REQUEST,
+        )
+
+    if _active_conflict(doctor_id, scheduled_at):
+        return Response(
+            {"detail": "해당 시간대에 이미 예약이 있습니다. 다른 시간을 선택해주세요."},
+            status=status.HTTP_409_CONFLICT,
+        )
+
+    appt = Appointment.objects.create(
+        patient_id=patient.patient_id,
+        doctor_id=doctor.doctor_id,
+        department=department,
+        scheduled_at=scheduled_at,
+        status=Appointment.STATUS_REQUESTED,
+        memo=(data.get("memo") or "").strip(),
+    )
+    return Response(
+        AppointmentSerializer(appt).data,
+        status=status.HTTP_201_CREATED,
+    )
+
+
+@extend_schema(tags=["appointments"])
+@api_view(["GET", "PATCH"])
+@permission_classes([IsAuthenticated])
+def appointment_detail(request, appointment_id: int):
+    appt = Appointment.objects.filter(id=appointment_id).first()
+    if appt is None:
+        return Response(
+            {"detail": "예약을 찾을 수 없습니다."},
+            status=status.HTTP_404_NOT_FOUND,
+        )
+
+    patient = _as_patient(request.user)
+    doctor = _as_doctor(request.user)
+
+    if patient is not None and appt.patient_id != patient.patient_id:
+        return Response({"detail": "권한이 없습니다."}, status=status.HTTP_403_FORBIDDEN)
+    if doctor is not None and appt.doctor_id != doctor.doctor_id:
+        return Response({"detail": "권한이 없습니다."}, status=status.HTTP_403_FORBIDDEN)
+    if patient is None and doctor is None:
+        return Response({"detail": "권한이 없습니다."}, status=status.HTTP_403_FORBIDDEN)
+
+    if request.method == "GET":
+        return Response(AppointmentSerializer(appt).data)
+
+    return _update_appointment(request, appt, patient=patient, doctor=doctor)
+
+
+def _update_appointment(request, appt: Appointment, *, patient, doctor):
+    ser = AppointmentUpdateSerializer(data=request.data, partial=True)
+    ser.is_valid(raise_exception=True)
+    data = ser.validated_data
+
+    # 환자: 변경(일시/의사/메모) 또는 취소만
+    if patient is not None:
+        new_status = data.get("status")
+        if new_status and new_status != Appointment.STATUS_CANCELLED:
+            return Response(
+                {"detail": "환자는 취소만 요청할 수 있습니다. 확정은 의료진이 처리합니다."},
+                status=status.HTTP_403_FORBIDDEN,
+            )
+
+        if new_status == Appointment.STATUS_CANCELLED:
+            if appt.status in (
+                Appointment.STATUS_CANCELLED,
+                Appointment.STATUS_COMPLETED,
+            ):
+                return Response(
+                    {"detail": "이미 종료된 예약입니다."},
+                    status=status.HTTP_400_BAD_REQUEST,
+                )
+            appt.status = Appointment.STATUS_CANCELLED
+            appt.save(update_fields=["status", "updated_at"])
+            return Response(AppointmentSerializer(appt).data)
+
+        if appt.status not in (
+            Appointment.STATUS_REQUESTED,
+            Appointment.STATUS_CONFIRMED,
+        ):
+            return Response(
+                {"detail": "변경할 수 없는 예약 상태입니다."},
+                status=status.HTTP_400_BAD_REQUEST,
+            )
+
+        doctor_id = data.get("doctor_id", appt.doctor_id)
+        if "doctor_id" in data:
+            doc = Doctor.objects.filter(doctor_id=doctor_id).first()
+            if doc is None:
+                return Response(
+                    {"detail": "선택한 의사를 찾을 수 없습니다."},
+                    status=status.HTTP_400_BAD_REQUEST,
+                )
+            appt.doctor_id = doc.doctor_id
+            if not data.get("department"):
+                appt.department = doc.department
+
+        if "department" in data and data["department"]:
+            appt.department = data["department"].strip()
+
+        if "scheduled_at" in data:
+            scheduled_at = data["scheduled_at"]
+            if timezone.is_naive(scheduled_at):
+                scheduled_at = timezone.make_aware(
+                    scheduled_at, timezone.get_current_timezone()
+                )
+            if scheduled_at <= timezone.now():
+                return Response(
+                    {"detail": "과거 일시로는 예약할 수 없습니다."},
+                    status=status.HTTP_400_BAD_REQUEST,
+                )
+            if _active_conflict(appt.doctor_id, scheduled_at, exclude_id=appt.id):
+                return Response(
+                    {"detail": "해당 시간대에 이미 예약이 있습니다. 다른 시간을 선택해주세요."},
+                    status=status.HTTP_409_CONFLICT,
+                )
+            appt.scheduled_at = scheduled_at
+            # 변경 시 다시 의료진 확정 필요
+            appt.status = Appointment.STATUS_REQUESTED
+
+        if "memo" in data:
+            appt.memo = (data.get("memo") or "").strip()
+
+        appt.save()
+        return Response(AppointmentSerializer(appt).data)
+
+    # 의사: 확정/완료/취소
+    if doctor is not None:
+        new_status = data.get("status")
+        if not new_status:
+            return Response(
+                {"detail": "status 필드가 필요합니다. (confirmed/cancelled/completed)"},
+                status=status.HTTP_400_BAD_REQUEST,
+            )
+        if new_status not in (
+            Appointment.STATUS_CONFIRMED,
+            Appointment.STATUS_CANCELLED,
+            Appointment.STATUS_COMPLETED,
+        ):
+            return Response(
+                {"detail": "의료진이 설정할 수 없는 상태입니다."},
+                status=status.HTTP_400_BAD_REQUEST,
+            )
+        appt.status = new_status
+        appt.save(update_fields=["status", "updated_at"])
+        return Response(AppointmentSerializer(appt).data)
+
+    return Response({"detail": "권한이 없습니다."}, status=status.HTTP_403_FORBIDDEN)
