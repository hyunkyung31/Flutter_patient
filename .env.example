# Copy to .env before running (never commit .env):
#   cp .env.example .env
KAKAO_NATIVE_APP_KEY=YOUR_NATIVE_APP_KEY
API_BASE_URL=https://your-api.example.com

# Optional Android-only override (gitignored):
#   android/local.properties -> kakao.native.app.key=YOUR_NATIVE_APP_KEY
#
# After changing Kakao keys/manifest, full rebuild is required:
#   flutter clean && flutter pub get && flutter run
#
# Kakao Developers Console must include:
#   package name: com.vena.patient_app
#   + Android key hash
